# 为 httpmech 保留文本文件的换行约定

* text=auto eol=lf

*.hpp   text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.c     text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Visual Studio 工程文件（以后加时用）
*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
